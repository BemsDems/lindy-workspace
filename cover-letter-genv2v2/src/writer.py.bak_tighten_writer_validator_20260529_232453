def _finalizer_user(
    *,
    universal_mode: bool,
    selected_project: str,
    project_company: str,
    project_industry: str,
    project_description: str,
    hook_phrase: str,
    selected_numbers: List[str],
    selected_achievements: List[str],
    allowed_tech: List[str],
    openers: List[str],
    feedback: Optional[str] = None,
) -> str:
    mode = (
        "UNIVERSAL: 1 короткий абзац, 60–90 слов" if universal_mode
        else "STANDARD: 2 коротких абзаца, 70–110 слов"
    )
    parts: List[str] = [
        f"MODE: {mode}",
        f"PROJECT: {selected_project}",
        "PROJECT_FACTS:",
        f"- company: {project_company}",
        f"- industry: {project_industry}",
        f"- description: {project_description}",
        f"HOOK: {hook_phrase}",
        f"SELECTED_NUMBERS: {json.dumps(selected_numbers, ensure_ascii=False)}",
        "ACHIEVEMENTS (разрешённые факты):",
    ]
    for a in selected_achievements:
        parts.append(f"- {a}")

    parts.append("")
    parts.append("ALLOWED_TECH (используй только эти термины):")
    for t in allowed_tech[:80]:
        parts.append(f"- {t}")

    parts.append("")
    parts.append("OPENERS (используй как смысл для первой фразы, но НЕ выноси отдельной строкой):")
    for o in openers:
        parts.append(f"- {o}")

    if feedback:
        parts.append("")
        parts.append("FEEDBACK ОТ ВАЛИДАТОРА:")
        parts.append(feedback)
        parts.append("Исправь это, но не упоминай feedback в письме.")

    parts.append("")
    parts.append("СТИЛЬ ДЛЯ ЭТОЙ ГЕНЕРАЦИИ:")
    parts.append("- Первое предложение сделай адресным под HOOK, но без пересказа вакансии.")
    parts.append("- Не начинай письмо одинаково, если можно начать с пользы для вакансии.")
    parts.append("- Во втором абзаце не перечисляй стек. Покажи пользу для продукта и команды.")
    parts.append("- Заверши мягким предложением обсудить задачи или показать релевантный опыт.")
    parts.append("- Не используй Dio, Auto Route, go_router, Hive, Retrofit, Provider, Riverpod, MobX в финальном письме.")
    parts.append("- Не используй слово бонусная система. Пиши бонусная система.")
    parts.append("")
    parts.append("СТИЛЬ ДЛЯ ЭТОЙ ГЕНЕРАЦИИ:")
    parts.append("- Сделай письмо менее шаблонным: не начинай с общей фразы «Увидел вашу вакансию и подумал...»")
    parts.append("- В первых двух предложениях обязательно укажи 3+ года опыта.")
    parts.append("- Начинай через релевантный production-опыт или конкретную задачу вакансии.")
    parts.append("- Покажи 1 сильную production-деталь: релиз, критический сценарий, обработка потери сети, стабильность, интеграция или архитектура.")
    parts.append("- Не используй числа из вакансии, масштаб компании или claims вроде 1,1 млн пользователей.")
    parts.append("- Не придумывай impact. Если точных цифр нет, усиливай через результат без числа.")
    parts.append("- Не используй video player, DRM, ExoPlayer, HLS, DASH, offline cache, WebSocket, Firestore, Amplitude, AppsFlyer, если этих терминов нет в ACHIEVEMENTS или ALLOWED_TECH.")
    parts.append("- Не используй Dio, Auto Route, go_router, Hive, Retrofit, Provider, Riverpod, MobX в финальном письме.")
    parts.append("- Не используй слово cashback. Пиши бонусная система.")
    parts.append("- Не заканчивай фразами «Этот опыт поможет», «Этот опыт может быть полезен», «Смогу быстро включиться», «Буду полезен».")
    parts.append("- Заверши конкретным next step: «Готов обсудить задачи и подробнее рассказать о релевантном опыте на собеседовании.»")
    parts.append("")
    parts.append("Напиши письмо по MODE. Верни только письмо, без комментариев.")
    return "\n".join(parts)


async def _final_letter_from_facts(
    llm: LLMClient,
    *,
    analyzer_json: Dict[str, Any],
    canonical_facts_brief: Dict[str, Any],
    opener_pool: List[str],
    universal_mode: bool,
    feedback: Optional[str] = None,
    max_tokens: int = 400,
) -> str:
    selected_project = str(analyzer_json.get("selected_project") or "")
    hook_phrase = str(analyzer_json.get("hook_phrase") or "")
    project_company = str(canonical_facts_brief.get("selected_project_company") or "")
    project_industry = str(canonical_facts_brief.get("selected_project_industry") or "")
    project_description = str(canonical_facts_brief.get("selected_project_description") or "")
    selected_achievements = list(analyzer_json.get("selected_achievements") or [])
    selected_numbers = _extend_selected_numbers_with_allowed_flutter_versions(
        list(analyzer_json.get("selected_numbers") or []),
        selected_achievements,
    )
    allowed_tech = list((canonical_facts_brief or {}).get("allowed_tech") or [])

    return await llm.generate(
        system_prompt=FINALIZER_SYSTEM,
        user_prompt=_finalizer_user(
            universal_mode=universal_mode,
            selected_project=selected_project,
            project_company=project_company,
            project_industry=project_industry,
            project_description=project_description,
            hook_phrase=hook_phrase,
            selected_numbers=selected_numbers,
            selected_achievements=selected_achievements,
            allowed_tech=allowed_tech,
            openers=list(opener_pool),
            feedback=feedback,
        ),
        temperature=0.2,
        max_tokens=max_tokens,
        json_mode=False,
    )


