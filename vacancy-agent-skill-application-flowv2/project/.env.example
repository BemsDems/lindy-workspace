# Browser settings
BROWSER_HEADLESS=false
BROWSER_TIMEOUT_MS=30000
BROWSER_DELAY_MIN=1.0
BROWSER_DELAY_MAX=3.0

# Scraping settings
MAX_RETRIES=2
MAX_VACANCIES_PER_SOURCE=30
STORE_RAW_HTML=false

# Logging
LOG_LEVEL=INFO

# Optional: connect to existing Chrome/Edge/Chromium over CDP
BROWSER_CDP_URL=

# Cover-letter generation
# auto = use sibling cover-letter-gen skill when found; simple = local fallback; cover_letter_gen = require external generator
COVER_LETTER_PROVIDER=auto
# If cover-letter-gen is not in ../cover-letter-gen, set absolute path:
# COVER_LETTER_GEN_PATH=/Users/pipyao/.openclaw/workspace-coding/skills/cover-letter-gen
# Optional overrides:
# COVER_LETTER_GEN_RESUME=/Users/pipyao/.openclaw/workspace-coding/skills/cover-letter-gen/config/resume.yaml
# COVER_LETTER_GEN_SETTINGS=/Users/pipyao/.openclaw/workspace-coding/skills/cover-letter-gen/config/settings.yaml
COVER_LETTER_APPEND_SIGNATURE=true
